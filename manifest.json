{
  "manifest_version": 3,
  "name": "素材采集器 · LAN Collector",
  "version": "1.6.3",
  "description": "在图片上右键一键剪藏，或区域截图 / 可视区截图 / 整页滚动截图 / 批量采集，直接保存到 NAS 或本机目录，不经过第三方素材库软件。",
  "minimum_chrome_version": "109",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "素材采集器",
    "default_icon": {
      "16": "assets/icons/16.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "128": "assets/icons/128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/util.js", "lib/imageproc.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "batch-collect": {
      "suggested_key": { "default": "Ctrl+1" },
      "description": "批量采集本页图片"
    },
    "region-shot": {
      "suggested_key": { "default": "Ctrl+2" },
      "description": "自定义区域截图"
    },
    "viewport-shot": {
      "suggested_key": { "default": "Ctrl+3" },
      "description": "可视区域截图"
    },
    "fullpage-shot": {
      "suggested_key": { "default": "Ctrl+4" },
      "description": "整页滚动截图"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "content/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "assets/icons/16.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  }
}
